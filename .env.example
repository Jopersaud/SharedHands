# Copy this file to .env and fill in the values. Never commit .env.
# Firebase web app config: Firebase Console > Project settings > General > Your apps
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Only uncomment if `npm start` fails with
# "options.allowedHosts[0] should be a non-empty string" (a Create React App
# bug when "proxy" is set). Local development only.
# DANGEROUSLY_DISABLE_HOST_CHECK=true
